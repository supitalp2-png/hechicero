[Unit]
Description=Hechicero — déclenche la sauvegarde quotidienne à 3h (TICKET-085)

[Timer]
OnCalendar=*-*-* 03:00:00
RandomizedDelaySec=300
# Persistent=true : si le Pi était éteint à 3h, le backup se lance peu après
# le prochain démarrage au lieu d'être simplement sauté (Hechicero n'est pas
# toujours allumé/en réseau la nuit).
Persistent=true

[Install]
WantedBy=timers.target
