[Unit]
Description=Hechicero — sauvegarde quotidienne (ghost SD non durcie, TICKET-085)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /home/thomas/hechicero/scripts/backup_manager.py daily
# Le script gère lui-même le cas NAS/réseau indisponible (n'échoue pas le service,
# enregistre l'échec dans data/backup_state.json pour la page admin).
