[Unit]
Description=Hechicero Play Tracker (MPD idle)
After=mpd.service
# ⚠️ `Wants=` et pas `Requires=` (corrigé le 2026-08-05, TICKET-122) :
# `Requires=` propage l'arrêt, donc un redémarrage de MPD — y compris par le
# chien de garde `mpd_watchdog` — emportait ce service avec lui, et le suivi
# d'écoute s'arrêtait définitivement sans que personne ne le remarque.
# Ici c'est sans risque : `Restart=always` ci-dessous relance le tracker s'il
# perd sa connexion MPD et sort.
Wants=mpd.service

[Service]
Type=simple
User=thomas
WorkingDirectory=/home/thomas/hechicero/scripts
ExecStart=/usr/bin/python3 /home/thomas/hechicero/scripts/play_tracker.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=play_tracker

# TICKET-011 — durcissement (2026-07-19) : ce service parle à MPD via son
# socket Unix (/run/mpd/socket, hors de /home donc non concerné par
# ProtectHome) et écrit dans data/tracking.db, rien d'autre.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/thomas/hechicero/data

[Install]
WantedBy=multi-user.target
