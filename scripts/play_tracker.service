[Unit]
Description=Hechicero Play Tracker (MPD idle)
After=mpd.service
Requires=mpd.service

[Service]
Type=simple
User=thomas
WorkingDirectory=/home/thomas/hechicero/scripts
ExecStart=/usr/bin/python3 /home/thomas/hechicero/scripts/play_tracker.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=play_tracker

# TICKET-011 — durcissement (2026-07-19) : ce service parle à MPD via son
# socket Unix (/run/mpd/socket, hors de /home donc non concerné par
# ProtectHome) et écrit dans data/tracking.db, rien d'autre.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/thomas/hechicero/data

[Install]
WantedBy=multi-user.target
