[Unit]
Description=Hechicero Battery Tracker
After=network.target mpd.service

[Service]
Type=simple
User=thomas
WorkingDirectory=/home/thomas/hechicero/scripts
ExecStart=/usr/bin/python3 /home/thomas/hechicero/scripts/battery_tracker.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# TICKET-011 — durcissement (2026-07-19) : lit le capteur I2C (INA219, via
# /dev/i2c-*, non concerné par ProtectSystem) et /sys/class/backlight (état
# écran), se connecte au socket MPD, écrit dans data/battery_*.json — rien
# d'autre. PAS de PrivateDevices : casserait l'accès I2C.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/thomas/hechicero/data

[Install]
WantedBy=multi-user.target