[Unit]
Description=Hechicero Buttons Daemon (8 boutons physiques GPIO, TICKET-091/101)
After=network.target mpd.service
# ⚠️ `Wants=` et surtout PAS `Requires=` (corrigé le 2026-08-05, TICKET-122).
# `Requires=` propage l'ARRÊT : quand mpd.service tombe — panne, ou SIGKILL du
# chien de garde qui le répare — systemd arrête aussi ce service, et tous les
# boutons physiques meurent avec MPD. Vécu en direct : MPD tué pour le
# débloquer, boutons HS dans la foulée.
# Les boutons doivent fonctionner même MPD absent : leurs actions passent par
# radio.php, qui gère déjà l'erreur de connexion proprement.
Wants=mpd.service

[Service]
Type=simple
User=root

# ── Répertoire de travail : /run, pas le dépôt (2026-08-04) ───────────────
# La bibliothèque lgpio (utilisée par RPi.GPIO sur Pi 5) crée un tube nommé
# `.lgd-nfy<N>` **dans le répertoire courant** pour la remontée d'événements
# GPIO. Avec WorkingDirectory=.../scripts, ce tube atterrissait dans le dépôt
# — un fichier binaire parasite, jamais versionné, qu'on finissait par prendre
# pour un déchet.
#
# Pire : depuis le durcissement TICKET-011, `ProtectSystem=strict` et
# `ProtectHome=read-only` rendent `scripts/` **non inscriptible** pour ce
# service. lgpio ne pouvait donc plus créer le tube ; ça ne se voyait pas
# uniquement parce qu'un `.lgd-nfy0` créé AVANT le durcissement traînait encore
# et se laissait simplement ouvrir. Le jour où il a été supprimé (2026-08-04,
# ménage du dépôt), le daemon s'est mis à planter au démarrage :
#   xCreatePipe: Can't set permissions (436) for .../scripts/.lgd-nfy0
#   FileNotFoundError: '.lgd-nfy-3'      (-3 = code d'erreur, pas un handle)
#
# RuntimeDirectory= crée /run/hechicero-buttons au démarrage, le rend
# inscriptible malgré ProtectSystem=strict, et le nettoie à l'arrêt. Le tube
# vit là, hors du dépôt et hors de la carte SD.
RuntimeDirectory=hechicero-buttons
RuntimeDirectoryMode=0750
WorkingDirectory=/run/hechicero-buttons

ExecStart=/usr/bin/python3 /home/thomas/hechicero/scripts/buttons_daemon.py
Restart=always
RestartSec=5

# TICKET-011 — durcissement (2026-07-19) : accès GPIO (9 boutons physiques),
# parle à MPD (socket + radio.php en HTTP local). PAS de PrivateDevices :
# casserait l'accès GPIO (vécu avec l'égaliseur sur /dev/snd, même piège
# possible ici sur /dev/gpiochip*).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/thomas/hechicero/data

[Install]
WantedBy=multi-user.target
