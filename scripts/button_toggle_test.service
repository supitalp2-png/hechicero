[Unit]
Description=Hechicero Button Toggle Test (bring-up GPIO, TICKET-091/031)
After=network.target mpd.service
Requires=mpd.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/thomas/hechicero/scripts
ExecStart=/usr/bin/python3 /home/thomas/hechicero/scripts/button_toggle_test.py --pin 17
Restart=always
RestartSec=5

# TICKET-011 — durcissement (2026-07-19) : ajouté par cohérence même si ce
# service reste désactivé (cf. docs/70-SERVICES_SYSTEMD.md §7bis — remplacé
# par buttons_daemon.service, à ne pas réactiver). Accès GPIO, donc PAS de
# PrivateDevices.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/thomas/hechicero/data

[Install]
WantedBy=multi-user.target
